{
  "name": "mission-catalog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:new": "supabase migration new",
    "db:push": "supabase db push --remote",
    "db:status": "supabase migration list --remote",
    "db:setup": "[ -f supabase/config.toml ] || supabase init; supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:rollback": "npx supabase migration down --last 1 --remote",
    "db:migrate": "npx supabase migration up --remote"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "i18next": "^27.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "supabase": "^3.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
